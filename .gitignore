.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Local data — raw A/V, extracted features, and annotations are never committed.
# Only .gitkeep placeholders (preserving the folder scaffolding) and a README are
# tracked under data/; every actual data file is ignored at any depth.
data/**
!data/**/
!data/**/.gitkeep
!data/README.md

# Generated artifacts — only the top-level .gitkeep placeholder is kept.
outputs/*
models/*
logs/*
!.gitkeep

# Environment files
.env

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code local files (settings.local.json, worktrees, etc.)
.claude/
